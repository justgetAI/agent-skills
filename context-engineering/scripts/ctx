#!/bin/sh
# ctx - Context Engineering CLI
# Quick spec/task creation and listing
#
# Usage:
#   ctx new spec <type> <name>     Create new spec (date-named)
#   ctx new task <spec> <name>     Create new task for spec
#   ctx list specs                 List all specs
#   ctx list tasks [spec]          List tasks (optionally filtered)
#   ctx help                       Show this help

set -e

CONTEXT_DIR="context"

# Check we're in a project with context/
check_context() {
    if [ ! -d "$CONTEXT_DIR" ]; then
        echo "Error: No context/ directory found."
        echo "Run init.sh first or cd to project root."
        exit 1
    fi
}

show_help() {
    echo "ctx - Context Engineering CLI"
    echo ""
    echo "Usage:"
    echo "  ctx new spec <type> <name>     Create new spec (type: feat|fix|improve)"
    echo "  ctx new task <spec> <name>     Create new task (e.g., ctx new task 2026-01-26-feat-payments setup)"
    echo "  ctx list specs                 List all specs (date-named and legacy numbered)"
    echo "  ctx list tasks [spec]          List tasks (optionally filter by spec stem/prefix)"
    echo "  ctx feedback <spec> <1-5> [issue]  Rate completed spec, auto-creates improve if ≤3"
    echo "  ctx help                       Show this help"
    echo ""
    echo "Spec naming: YYYY-MM-DD-<type>-<name>.md (canonical)"
    echo "Legacy numbered specs (feat001-name.md) are still discovered."
    echo ""
    echo "Examples:"
    echo "  ctx new spec feat payments"
    echo "  ctx new task 2026-01-26-feat-payments stripe-integration"
    echo "  ctx list specs"
    echo "  ctx list tasks 2026-01-26-feat-payments"
    echo "  ctx feedback 2026-01-26-feat-payments 2 too-verbose"
    echo "  ctx feedback improve001 3 log-taxonomy   # legacy numbered still works"
}

today() {
    date +%Y-%m-%d
}

# Basename without .md
spec_stem() {
    basename "$1" .md
}

# Task-filter prefix for a spec file:
# - date-named: full stem (2026-01-26-feat-payments)
# - legacy numbered: type+num only (feat001)
spec_task_prefix() {
    stem="$1"
    case "$stem" in
        feat[0-9]*|fix[0-9]*|improve[0-9]*)
            echo "$stem" | sed 's/^\([a-z]*[0-9][0-9]*\)-.*/\1/'
            ;;
        *)
            echo "$stem"
            ;;
    esac
}

# Resolve user arg to a spec filepath. Accepts:
# - full stem: 2026-01-26-feat-payments
# - legacy prefix: feat001 / improve001
# - unique substring of the stem
resolve_spec_file() {
    arg="$1"
    specs_dir="$CONTEXT_DIR/specs"

    if [ -f "$specs_dir/${arg}.md" ]; then
        echo "$specs_dir/${arg}.md"
        return 0
    fi

    # Legacy numbered: feat001 → feat001-*.md
    match=$(ls "$specs_dir/${arg}-"*.md 2>/dev/null | head -1)
    if [ -n "$match" ] && [ -f "$match" ]; then
        echo "$match"
        return 0
    fi

    # Unique substring match on stem
    matches=""
    count=0
    for f in "$specs_dir"/*.md; do
        [ -f "$f" ] || continue
        stem=$(spec_stem "$f")
        case "$stem" in
            *"$arg"*)
                matches="$matches$f
"
                count=$((count + 1))
                ;;
        esac
    done

    if [ "$count" -eq 1 ]; then
        echo "$matches" | head -1
        return 0
    fi
    if [ "$count" -gt 1 ]; then
        echo "Error: Ambiguous spec '$arg'. Matches:" >&2
        echo "$matches" | while read -r f; do
            [ -n "$f" ] && echo "  $(spec_stem "$f")" >&2
        done
        return 1
    fi

    echo "Error: No spec found matching '$arg'" >&2
    return 1
}

# Get next task number for a spec prefix (full stem or legacy feat001)
next_task_num() {
    spec="$1"
    existing=$(ls "$CONTEXT_DIR/tasks/" 2>/dev/null | grep "^${spec}-task[0-9]" | sed "s/${spec}-task\([0-9]*\).*/\1/" | sort -n | tail -1)
    if [ -z "$existing" ]; then
        echo "001"
    else
        printf "%03d" $((existing + 1))
    fi
}

cmd_new_spec() {
    type="$1"
    name="$2"

    if [ -z "$type" ] || [ -z "$name" ]; then
        echo "Error: Usage: ctx new spec <type> <name>"
        echo "Types: feat, fix, improve"
        exit 1
    fi

    case "$type" in
        feat|fix|improve) ;;
        *)
            echo "Error: Invalid type '$type'. Use feat, fix, or improve."
            exit 1
            ;;
    esac

    # Normalize name to slug
    name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//')
    day=$(today)
    filename="${day}-${type}-${name}.md"
    filepath="$CONTEXT_DIR/specs/$filename"

    if [ -f "$filepath" ]; then
        echo "Error: Spec already exists: $filepath"
        exit 1
    fi

    cat > "$filepath" << ENDOFSPEC
# ${type}: ${name}

Linear: N/A

## Problem
{describe the problem}

## Tasks
- [ ] task001: {first task}

## Notes
{optional}
ENDOFSPEC

    echo "Created $filepath"
}

cmd_new_task() {
    spec_arg="$1"
    name="$2"

    if [ -z "$spec_arg" ] || [ -z "$name" ]; then
        echo "Error: Usage: ctx new task <spec> <name>"
        echo "Example: ctx new task 2026-01-26-feat-payments stripe-integration"
        exit 1
    fi

    specfile=$(resolve_spec_file "$spec_arg") || exit 1
    stem=$(spec_stem "$specfile")
    prefix=$(spec_task_prefix "$stem")

    num=$(next_task_num "$prefix")
    filename="${prefix}-task${num}-${name}.md"
    filepath="$CONTEXT_DIR/tasks/$filename"

    cat > "$filepath" << ENDOFTASK
# ${prefix}-task${num}: ${name}

Status: todo

## Goal
{1-2 sentences}

## Changes
- {bullet per change}

## Discoveries
{findings for foundation - human reviews}

## Blockers
none
ENDOFTASK

    echo "Created $filepath"
}

cmd_list_specs() {
    check_context
    echo "Specs:"
    found=0
    for f in "$CONTEXT_DIR/specs/"*.md; do
        [ -f "$f" ] || continue
        found=1
        name=$(spec_stem "$f")
        prefix=$(spec_task_prefix "$name")
        total=$(ls "$CONTEXT_DIR/tasks/" 2>/dev/null | grep -c "^${prefix}-task" || true)
        completed=$(grep -l "^Status: done" "$CONTEXT_DIR/tasks/${prefix}-task"*.md 2>/dev/null | wc -l | tr -d ' ')
        completed=${completed:-0}
        echo "  $name [$completed/$total tasks]"
    done
    if [ "$found" -eq 0 ]; then
        echo "  (none)"
    fi
}

cmd_list_tasks() {
    check_context
    filter="$1"

    if [ -n "$filter" ]; then
        # Resolve to task prefix when filter names a spec
        if specfile=$(resolve_spec_file "$filter" 2>/dev/null); then
            filter=$(spec_task_prefix "$(spec_stem "$specfile")")
        fi
    fi

    echo "Tasks:"
    found=0
    for f in "$CONTEXT_DIR/tasks/"*.md; do
        [ -f "$f" ] || continue
        name=$(spec_stem "$f")

        if [ -n "$filter" ]; then
            case "$name" in
                ${filter}-*) ;;
                *) continue ;;
            esac
        fi

        found=1
        status=$(grep "^Status:" "$f" 2>/dev/null | head -1 | sed 's/Status: //' || echo "unknown")
        echo "  $name [$status]"
    done
    if [ "$found" -eq 0 ]; then
        echo "  (none)"
    fi
}

cmd_feedback() {
    spec_arg="$1"
    rating="$2"
    issue="$3"

    if [ -z "$spec_arg" ] || [ -z "$rating" ]; then
        echo "Error: Usage: ctx feedback <spec> <1-5> [issue-slug]"
        echo "Example: ctx feedback 2026-01-26-feat-payments 2 too-verbose"
        exit 1
    fi

    case "$rating" in
        1|2|3|4|5) ;;
        *)
            echo "Error: Rating must be 1-5"
            exit 1
            ;;
    esac

    specfile=$(resolve_spec_file "$spec_arg") || exit 1
    stem=$(spec_stem "$specfile")

    if grep -q "^Rating:" "$specfile" 2>/dev/null; then
        sed -i "s/^Rating:.*/Rating: $rating/" "$specfile"
    else
        if ! grep -q "^## Feedback" "$specfile" 2>/dev/null; then
            echo "" >> "$specfile"
            echo "## Feedback" >> "$specfile"
            echo "Rating: $rating" >> "$specfile"
            echo "Issue: ${issue:-none}" >> "$specfile"
        else
            sed -i "s/^Rating:.*/Rating: $rating/" "$specfile"
        fi
    fi

    if [ -n "$issue" ]; then
        if grep -q "^Issue:" "$specfile" 2>/dev/null; then
            sed -i "s/^Issue:.*/Issue: $issue/" "$specfile"
        else
            echo "Issue: $issue" >> "$specfile"
        fi
    fi

    echo "Updated $specfile with rating $rating"

    # Auto-create improve spec if rating <= 3 and issue provided
    if [ "$rating" -le 3 ] && [ -n "$issue" ]; then
        issue_slug=$(echo "$issue" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//')
        day=$(today)
        filename="${day}-improve-${issue_slug}.md"
        filepath="$CONTEXT_DIR/specs/$filename"

        if [ -f "$filepath" ]; then
            echo "Improve spec already exists: $filepath"
            return 0
        fi

        cat > "$filepath" << ENDOFIMPROVE
# improve: ${issue_slug}

Linear: N/A
Source: ${stem}

## Problem
Feedback from ${stem}: rating $rating/5
Issue: ${issue}

## Tasks
- [ ] task001: analyze-root-cause
- [ ] task002: implement-fix

## Notes
Auto-generated from feedback on ${stem}
ENDOFIMPROVE

        echo "Created $filepath (auto-generated from low rating)"
    fi
}

# Main command routing
case "$1" in
    new)
        check_context
        case "$2" in
            spec) cmd_new_spec "$3" "$4" ;;
            task) cmd_new_task "$3" "$4" ;;
            *) echo "Error: ctx new <spec|task>"; exit 1 ;;
        esac
        ;;
    list)
        case "$2" in
            specs) cmd_list_specs ;;
            tasks) cmd_list_tasks "$3" ;;
            *) echo "Error: ctx list <specs|tasks>"; exit 1 ;;
        esac
        ;;
    feedback)
        check_context
        cmd_feedback "$2" "$3" "$4"
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        show_help
        ;;
    *)
        echo "Error: Unknown command '$1'"
        show_help
        exit 1
        ;;
esac
